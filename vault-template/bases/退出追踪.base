filters:
  and:
    - file.inFolder("1-portfolio/companies")
    - '!file.name.startsWith("_")'
    - 'note.type == "portfolio-company"'
    - '["active", "struggling", "fundraising"].contains(note.status)'
    - or:
        - 'note.current_funding_round == "ipo-prep"'
        - 'note.current_funding_round == "ma-negotiation"'

properties:
  file.name:
    displayName: 公司
  note.current_funding_round:
    displayName: 阶段
  note.latest_post_money_valuation:
    displayName: 当前估值 (万)
  note.total_invested:
    displayName: 累计投入 (万)
  note.current_moic:
    displayName: 预期 MOIC
  note.my_board_role:
    displayName: 董事会角色

views:
  - type: table
    name: 🚪 退出追踪
    limit: 50
    order:
      - file.name
      - note.current_funding_round
      - note.current_moic
      - note.latest_post_money_valuation
      - note.total_invested
      - note.my_board_role
    sort:
      - property: note.current_moic
        direction: DESC
