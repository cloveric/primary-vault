filters:
  and:
    - file.inFolder("1-portfolio/companies")
    - '!file.name.startsWith("_")'
    - 'note.type == "portfolio-company"'
    - '["active", "struggling", "fundraising"].contains(note.status)'

formulas:
  # 从没收过 update 的，从首次投资日起算
  silent_days: '(today() - if(note.last_update, note.last_update, note.first_investment_date)).days.round()'
  status_emoji: 'if(formula.silent_days > 120, "🔴 太久", if(formula.silent_days > 90, "🟡 该 ping", "✅ 正常"))'

properties:
  file.name:
    displayName: 公司
  formula.status_emoji:
    displayName: 状态
  formula.silent_days:
    displayName: 沉默天数
  note.last_update:
    displayName: 最近 update
  note.primary_founder:
    displayName: 创始人

views:
  - type: table
    name: 😴 沉默超过 90 天
    limit: 30
    filters:
      'formula.silent_days > 90'
    order:
      - file.name
      - formula.status_emoji
      - formula.silent_days
      - note.last_update
      - note.primary_founder
    sort:
      - property: formula.silent_days
        direction: DESC
