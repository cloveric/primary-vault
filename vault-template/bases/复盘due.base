filters:
  and:
    - file.inFolder("1-portfolio/companies")
    - '!file.name.startsWith("_")'
    - 'note.type == "portfolio-company"'
    - '["active", "struggling", "fundraising"].contains(note.status)'
    - 'note.next_review_due < today()'

formulas:
  overdue_days: '(today() - note.next_review_due).days.round()'

properties:
  file.name:
    displayName: 公司
  formula.overdue_days:
    displayName: 超期 (天)
  note.next_review_due:
    displayName: 下次复盘
  note.total_invested:
    displayName: 累计投入 (万)
  note.follow_on_priority:
    displayName: follow-on 优先级
  note.runway_months:
    displayName: Runway

views:
  - type: table
    name: ⏰ 复盘 due
    limit: 50
    order:
      - file.name
      - formula.overdue_days
      - note.next_review_due
      - note.follow_on_priority
      - note.runway_months
      - note.total_invested
    sort:
      - property: formula.overdue_days
        direction: DESC
