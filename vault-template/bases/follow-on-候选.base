filters:
  and:
    - file.inFolder("1-portfolio/companies")
    - '!file.name.startsWith("_")'
    - 'note.type == "portfolio-company"'
    - '["active", "struggling", "fundraising"].contains(note.status)'
    - 'note.follow_on_priority == "high"'

properties:
  file.name:
    displayName: 公司
  note.follow_on_priority:
    displayName: 优先级
  note.current_funding_round:
    displayName: 当前融资轮
  note.next_review_due:
    displayName: 下次复盘
  note.total_invested:
    displayName: 累计投入 (万)
  note.latest_post_money_valuation:
    displayName: 估值 (万)
  note.current_moic:
    displayName: MOIC

views:
  - type: table
    name: 🎯 Follow-on 候选
    limit: 30
    filters:
      'note.current_funding_round != "none"'
    order:
      - file.name
      - note.current_funding_round
      - note.next_review_due
      - note.current_moic
      - note.total_invested
      - note.latest_post_money_valuation
    sort:
      - property: note.next_review_due
        direction: ASC
